# Copy this file to `.env` and fill in your values.
# The Flask app loads `.env` automatically (via python-dotenv).

# GitHub API token — avoids the unauthenticated rate limit (60 req/hr).
# Create one at https://github.com/settings/tokens (public repos scope is enough).
GITHUB_TOKEN=

# --- Contact form SMTP ---
# Used by POST /api/contact to deliver messages from the contact form.
# If these are left empty, the form shows a graceful "email me directly" fallback
# (opens the visitor's mail client addressed to MAIL_RECIPIENT / your address below).

# SMTP server host and port. Gmail example shown.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# The account that sends the message.
# For Gmail you need an "App Password" (not your normal password):
#   Google Account -> Security -> 2-Step Verification -> App passwords
MAIL_USERNAME=your.email@gmail.com
MAIL_PASSWORD=your-app-password

# Where messages are delivered (leave blank to send to MAIL_USERNAME).
MAIL_RECIPIENT=atikrj8@gmail.com

# --- Server ---
# Debug mode: set to "true" during development only.
FLASK_DEBUG=false
# Port to listen on (default 5000).
PORT=5000
